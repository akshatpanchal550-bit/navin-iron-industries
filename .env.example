# Copy this file to .env and fill in real values before running the server.
# Never commit the real .env file.

# Port the server runs on
PORT=3000

# Random long random string used to sign admin login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Admin login credentials (used to create the first admin account on first run)
ADMIN_EMAIL=navinironindustries@gmail.com
ADMIN_PASSWORD=change-this-password

# Gmail SMTP settings used to SEND notification emails.
# GMAIL_USER is the Gmail account that sends the email.
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification on).
GMAIL_USER=your-sending-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where visit / contact notifications are sent
NOTIFY_EMAIL=navinironindustries@gmail.com

# Minutes to wait before the same visitor (by browser) can trigger another visit email
VISIT_NOTIFY_COOLDOWN_MINUTES=60

# Cloudinary (free) settings used to store uploaded product photos permanently.
# Sign up free at https://cloudinary.com, then copy these 3 values from your Dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Supabase (free) database — stores admin login, products, and visit logs permanently.
# Sign up free at https://supabase.com, create a project, then go to
# Project Settings -> API to find these two values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key
